# Server Configuration
PORT=8000
ENV=development
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=bravo

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Webhook (secreto compartido para callbacks del banco)
WEBHOOK_SECRET=dev-webhook-secret
# Países con evaluación asíncrona (banco llama de vuelta al webhook)
ASYNC_BANK_COUNTRIES=BR

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Bank Providers (WireMock)
ESP_BANK_URL=http://localhost:8080/esp
PT_BANK_URL=http://localhost:8080/pt
IT_BANK_URL=http://localhost:8080/it
MX_BANK_URL=http://localhost:8080/mx
CO_BANK_URL=http://localhost:8080/co
BR_BANK_URL=http://localhost:8080/br

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Application
MAX_RETRIES=3
REQUEST_TIMEOUT=30s
IDEMPOTENCY_TTL=24h
