                    "type": "string",
                    "example": "MX"
                },
                "full_name": {
                    "type": "string",
                    "example": "Juan Pérez"
                },
                "identity_document": {
                    "type": "string",
                    "example": "CURP123456"
                },
                "monthly_income": {
                    "type": "number",
                    "example": 15000
                },
                "requested_amount": {
                    "type": "number",
                    "example": 50000
                }
            }
        },
        "github_com_Sirpyerre_bravo-challenge_internal_service.ListApplicationsResponse": {
            "type": "object",
            "properties": {
