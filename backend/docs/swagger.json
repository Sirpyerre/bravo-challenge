                    "type": "string",
                    "example": "secret123"
                }
            }
        },
        "github_com_Sirpyerre_bravo-challenge_internal_service.RegisterRequest": {
            "type": "object",
            "properties": {
                "country": {
                    "type": "string",
                    "example": "MX"
                },
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "secret123"
                },
                "role": {
                    "type": "string",
                    "example": "USER"
