                },
                "created_at": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "identity_document": {
                    "type": "string"
                },
                "monthly_income": {
                    "type": "number"
